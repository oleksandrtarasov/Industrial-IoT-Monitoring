{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Jwt": {
    "Issuer": "IndustrialIoT",
    "Audience": "IndustrialIoT.Clients",
    "AccessTokenMinutes": 120,
    "DemoUsers": [
      {
        "Username": "operator",
        "Role": "Operator"
      },
      {
        "Username": "viewer",
        "Role": "Viewer"
      }
    ]
  },
  "Modbus": {
    "PollIntervalSeconds": 5
  },
  "CommandExecution": {
    "PollIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 3,
    "BaseBackoffSeconds": 5,
    "ExecutionTimeoutSeconds": 30
  }
}
