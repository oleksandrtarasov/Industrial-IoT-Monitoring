{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CommandExecution": {
    "PollIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 3,
    "BaseBackoffSeconds": 5,
    "ExecutionTimeoutSeconds": 30
  }
}
